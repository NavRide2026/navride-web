{
  "name": "web-navride",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "generate:legal": "node scripts/generate-legal-html.mjs",
    "prebuild": "npm run generate:legal",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate:product": "node scripts/validate-product-registry.mjs",
    "test:product": "node scripts/validate-product-registry.mjs && node --test tests/product/*.test.mjs",
    "test:route-studio": "node --import ./scripts/ts-ext-resolve-register.mjs --experimental-strip-types --test tests/route-studio/*.test.mjs",
    "test": "npm run test:product && npm run test:route-studio"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.49.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.5.0",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.8",
    "radix-ui": "^1.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
